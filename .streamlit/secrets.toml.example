# Copy these into Streamlit Cloud > App > Settings > Secrets.
# Do not commit .streamlit/secrets.toml with real values.

APP_ENV = "production"
# ENV is accepted as a fallback alias for APP_ENV.
ENV = "production"
POLYGON_API_KEY = ""
OPENAI_API_KEY = ""
# Free tier is sufficient: the calendar is fetched once a day as a single bulk
# CSV (no symbol parameter) against a 25/day cap, then filtered locally.
ALPHAVANTAGE_API_KEY = ""
EARNINGS_BLOCKER_ENABLED = "true"
EARNINGS_CALENDAR_HORIZON = "3month"
VIX_SPIKE_PCT = "8"
# Daily timeframe context. Cached per trading day: one request per symbol on the
# first scan of the session, nothing afterwards.
DAILY_CONTEXT_ENABLED = "true"
DAILY_CONTEXT_LOOKBACK_DAYS = "120"
# IV against realised volatility. Observing until a day of data justifies a gate.
MAX_IV_RV_RATIO = "2.0"
IV_RICHNESS_ENFORCE = "false"
ENABLE_AI_SUMMARY = "false"

# =========================
# DATABASE
# =========================
# Use the pooler URL for DATABASE_URL in Streamlit runtime.
# Replace only the password placeholder in Streamlit Cloud Secrets.
DATABASE_URL = "postgresql+psycopg2://neondb_owner:PASTE_ROTATED_PASSWORD_HERE@ep-round-pond-atro9w6h-pooler.c-9.us-east-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_DIRECT_URL = "postgresql+psycopg2://neondb_owner:PASTE_ROTATED_PASSWORD_HERE@ep-round-pond-atro9w6h.c-9.us-east-1.aws.neon.tech/neondb?sslmode=require"
DB_WRITE_ENABLED = "true"
DB_POOL_SIZE = "5"
DB_MAX_OVERFLOW = "5"
DB_CONNECT_TIMEOUT_SECONDS = "10"
# Set true before a session you want to archive for Historical Scanner Regression.
# Requires DB_WRITE_ENABLED = "true" and migrations 013/014 in Neon.
REGRESSION_SNAPSHOT_ENABLED = "false"

# Optional fallback if using Streamlit native connections.
# The app still needs DB_WRITE_ENABLED at the root level.
#[connections.trading_db]
#url = "postgresql+psycopg2://neondb_owner:PASTE_ROTATED_PASSWORD_HERE@ep-round-pond-atro9w6h-pooler.c-9.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Optional fallback if grouping database settings.
#[database]
#url = "postgresql+psycopg2://neondb_owner:PASTE_ROTATED_PASSWORD_HERE@ep-round-pond-atro9w6h-pooler.c-9.us-east-1.aws.neon.tech/neondb?sslmode=require"
#direct_url = "postgresql+psycopg2://neondb_owner:PASTE_ROTATED_PASSWORD_HERE@ep-round-pond-atro9w6h.c-9.us-east-1.aws.neon.tech/neondb?sslmode=require"
#write_enabled = "true"

USE_MOCK_MARKET_DATA = "false"
USE_MOCK_OPTIONS = "false"
SCANNER_OUTPUT_FILE = "scanner_output.xlsx"
TELEGRAM_ALERTS_ENABLED = "false"
TELEGRAM_ENTRY_ALERTS_ENABLED = "true"
TELEGRAM_EXIT_ALERTS_ENABLED = "true"
TELEGRAM_ALERT_POLICY = "PAPER"
# Removed: the eleven alert-throttle settings that used to sit here were read
# into a policy dict and never applied -- the helpers that would have enforced
# them were never called. Entry alerts are one-to-one with opened positions, so
# the limits that matter are on the entry path: MAX_DAILY_ENTRIES,
# MAX_ACTIVE_PAPER_TRADES, MAX_ACTIVE_PER_DIRECTION,
# AUTO_PAPER_SYMBOL_COOLDOWN_MINUTES and MAX_TRADES_PER_SYMBOL_PER_DAY.
TELEGRAM_MIN_OPTION_QUALITY_SCORE = "65"
TELEGRAM_MIN_RR = "1.8"
TELEGRAM_MAX_SPREAD_PCT = "6"
TELEGRAM_MIN_PAPER_ENTRY_SETUP_SCORE = "70"
# Exit price mismatch threshold. Exit alerts resolve same-symbol current price
# from latest_quote, then 5-minute close, then 15-minute close before validation.
TELEGRAM_EXIT_PRICE_MISMATCH_PCT = "0.03"
POLYGON_RATE_LIMIT_PER_MINUTE = "1200"
POLYGON_CACHE_TTL = "10"
POLYGON_LAST_PRICE_TTL = "10"
# Client profile: 5,000-10,000 rotated intraday, 3-5 quality positions a day, a
# 5.00 limit price per contract, 1-3 weeks to expiry and inside a week for QQQ/SPY.
# Set at the conservative end of the capital range: this figure sizes risk per trade.
ACCOUNT_SIZE = "5000"
RISK_PERCENT = "10"
OPTION_AFFORDABILITY_MODE = "HARD"
OPTION_CAPITAL_PROFILE = "SMALL_ACCOUNT"
DAILY_START_CAPITAL = "5000"
CAPITAL_GROWTH_MODE = "true"
# Both of these were previously ignored by the automated entry path, which
# hardcoded 3 concurrent and 1 per direction. They are honoured now.
MAX_ACTIVE_PAPER_TRADES = "4"
MAX_DAILY_ENTRIES = "5"
# Was a hardcoded 1: a single open CALL blocked every other bullish setup, and
# under a MULTIDAY profile that block persisted overnight.
MAX_ACTIVE_PER_DIRECTION = "3"
MAX_CONTRACTS_PER_TRADE = "1"

# Affordability is measured at the price a buy order actually pays, the ask.
# 1.0 = ask, and guarantees a contract is buyable inside the limit. 0.5 restores
# the old midpoint behaviour, which approved contracts costing up to 530 against
# a 500 limit.
AFFORDABILITY_FILL_FRACTION = "1.0"

# Enforcing since 2026-07-31. Replaying the archive through evaluate_stop_viability
# gave 25 ENTER_PAPER rows with all five inputs present, and their spread multiples
# break cleanly at 1.0 -- below it the move to the stop cannot cover the round-trip
# spread even once, so the option cannot profit before the underlying stops out.
# 1.0 rejects 8 of the 25 (32%); 1.5 would reject 12 (48%) by also taking the
# 1.05-1.43 band, which is thin but winnable. Raise it when resolved trades show
# that band losing money. 0 disables the check.
STOP_VIABILITY_ENFORCE = "true"
MIN_STOP_SPREAD_MULTIPLE = "1.0"
AUTO_PAPER_ENABLED = "true"
# Default off. Paper-only validation for strict REVIEW_TV_CHART rows.
ALLOW_REVIEW_TV_CHART_AUTO_PAPER = "false"
REAL_TRADING_ENABLED = "false"
REAL_ALERTS_ONLY = "true"
REAL_MAX_TRADES_PER_DAY = "1"
REAL_MIN_SETUP = "88"
REAL_MIN_RR = "2.0"
REAL_MIN_OPTION_QUALITY = "90"
REAL_MAX_SPREAD_PCT = "8"
REAL_MAX_QUOTE_AGE_MINUTES = "3"
REAL_ENTRY_CUTOFF_ET = "14:30"
ENABLE_MANUAL_PAPER_ENTRIES = "false"
SHOW_MANUAL_PAPER_BUTTONS = "false"
ALLOW_MANUAL_PAPER_CLOSE = "true"
# Validation mode: allow limited same-symbol repeat data collection.
# Customer-style alerts later: use "60" and "1".
AUTO_PAPER_SYMBOL_COOLDOWN_MINUTES = "45"
MAX_TRADES_PER_SYMBOL_PER_DAY = "2"
OPTION_STOP_LOSS_PCT = "0.20"
OPTION_MAX_RISK_PER_TRADE_PCT = "0.10"
OPTION_MIN_CONTRACT_COST = "100"
OPTION_PREFERRED_MAX_CONTRACT_COST = "400"
OPTION_MAX_CONTRACT_COST = "500"
OPTION_AGGRESSIVE_MAX_CONTRACT_COST = "750"
# The real binding constraint on which underlyings are reachable at a 500 limit,
# not the cost cap: the ranker walks out of the money to find something under the
# limit and stops here. Past this you are buying lottery tickets.
OPTION_MIN_AFFORDABLE_DELTA = "0.25"

# A 10% round trip starts the position 10% down and is not recoverable by being
# right about direction. 6 also keeps this consistent with the stop-viability
# check, which at the 0.50% stop floor only clears spreads to about 4.3%.
OPTION_MAX_SPREAD_PCT = "6"

# Clients buy 1-3 weeks out, and inside a week for QQQ/SPY. MIN_DTE was 10, which
# made the QQQ/SPY weekly unreachable -- at a 5.00 limit those two only price
# inside the cap at 5 DTE or less.
OPTION_MIN_DTE = "5"
OPTION_PREFERRED_MIN_DTE = "7"
OPTION_PREFERRED_MAX_DTE = "21"
OPTION_MAX_DTE = "30"

MAX_DAILY_REAL_LOSS = "1000"
OPTION_SHOW_BEST_QUALITY_CONTRACT = "true"
OPTION_SHOW_AFFORDABLE_ALTERNATE = "true"

[telegram]
bot_token = "YOUR_BOT_TOKEN_FROM_BOTFATHER"
chat_id = "YOUR_TELEGRAM_CHAT_ID"

# TOML note: keys after [telegram] belong to the telegram table until another
# [section] starts. Keep root-level DB keys above [telegram], or use [database].
