# Copy these into Streamlit Cloud > App > Settings > Secrets.
# Do not commit .streamlit/secrets.toml with real values.

APP_ENV = "production"
# ENV is accepted as a fallback alias for APP_ENV.
ENV = "production"
POLYGON_API_KEY = ""
OPENAI_API_KEY = ""
ENABLE_AI_SUMMARY = "false"

# =========================
# DATABASE
# =========================
# Use the pooler URL for DATABASE_URL in Streamlit runtime.
# Replace only the password placeholder in Streamlit Cloud Secrets.
DATABASE_URL = "postgresql+psycopg2://neondb_owner:PASTE_ROTATED_PASSWORD_HERE@ep-round-pond-atro9w6h-pooler.c-9.us-east-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_DIRECT_URL = "postgresql+psycopg2://neondb_owner:PASTE_ROTATED_PASSWORD_HERE@ep-round-pond-atro9w6h.c-9.us-east-1.aws.neon.tech/neondb?sslmode=require"
DB_WRITE_ENABLED = "true"
DB_POOL_SIZE = "5"
DB_MAX_OVERFLOW = "5"
DB_CONNECT_TIMEOUT_SECONDS = "10"

# Optional fallback if using Streamlit native connections.
# The app still needs DB_WRITE_ENABLED at the root level.
#[connections.trading_db]
#url = "postgresql+psycopg2://neondb_owner:PASTE_ROTATED_PASSWORD_HERE@ep-round-pond-atro9w6h-pooler.c-9.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Optional fallback if grouping database settings.
#[database]
#url = "postgresql+psycopg2://neondb_owner:PASTE_ROTATED_PASSWORD_HERE@ep-round-pond-atro9w6h-pooler.c-9.us-east-1.aws.neon.tech/neondb?sslmode=require"
#direct_url = "postgresql+psycopg2://neondb_owner:PASTE_ROTATED_PASSWORD_HERE@ep-round-pond-atro9w6h.c-9.us-east-1.aws.neon.tech/neondb?sslmode=require"
#write_enabled = "true"

USE_MOCK_MARKET_DATA = "false"
USE_MOCK_OPTIONS = "false"
SCANNER_OUTPUT_FILE = "scanner_output.xlsx"
TELEGRAM_ALERTS_ENABLED = "false"
TELEGRAM_ENTRY_ALERTS_ENABLED = "true"
TELEGRAM_EXIT_ALERTS_ENABLED = "true"
TELEGRAM_MAX_ENTRY_ALERTS_PER_DAY = "3"
TELEGRAM_MAX_ACTIVE_ALERTED_TRADES = "2"
TELEGRAM_ENTRY_COOLDOWN_MINUTES = "60"
TELEGRAM_SYMBOL_COOLDOWN_MINUTES = "60"
TELEGRAM_TOP_CANDIDATE_LIMIT = "3"
TELEGRAM_MIN_ENTRY_ALERT_SCORE = "85"
TELEGRAM_INSTANT_ENTRY_ALERT_SCORE = "88"
TELEGRAM_AFTERNOON_MIN_ENTRY_ALERT_SCORE = "90"
TELEGRAM_MIN_OPTION_QUALITY_SCORE = "65"
TELEGRAM_MIN_RR = "2.0"
TELEGRAM_MAX_SPREAD_PCT = "8"
TELEGRAM_MIN_PAPER_ENTRY_SETUP_SCORE = "70"
TELEGRAM_MAX_MORNING_ENTRY_ALERTS = "2"
TELEGRAM_MAX_MIDDAY_ENTRY_ALERTS = "1"
TELEGRAM_MAX_AFTERNOON_ENTRY_ALERTS = "1"
# Exit price mismatch threshold. Exit alerts resolve same-symbol current price
# from latest_quote, then 5-minute close, then 15-minute close before validation.
TELEGRAM_EXIT_PRICE_MISMATCH_PCT = "0.03"
POLYGON_RATE_LIMIT_PER_MINUTE = "1200"
POLYGON_CACHE_TTL = "10"
POLYGON_LAST_PRICE_TTL = "10"
ACCOUNT_SIZE = "25000"
RISK_PERCENT = "2"
OPTION_AFFORDABILITY_MODE = "HARD"
OPTION_CAPITAL_PROFILE = "SMALL_ACCOUNT"
DAILY_START_CAPITAL = "1000"
CAPITAL_GROWTH_MODE = "true"
MAX_ACTIVE_PAPER_TRADES = "1"
MAX_DAILY_ENTRIES = "3"
AUTO_PAPER_ENABLED = "true"
# Default off. Paper-only validation for strict REVIEW_TV_CHART rows.
ALLOW_REVIEW_TV_CHART_AUTO_PAPER = "false"
ENABLE_MANUAL_PAPER_ENTRIES = "false"
SHOW_MANUAL_PAPER_BUTTONS = "false"
ALLOW_MANUAL_PAPER_CLOSE = "true"
# Validation mode: allow limited same-symbol repeat data collection.
# Customer-style alerts later: use "60" and "1".
AUTO_PAPER_SYMBOL_COOLDOWN_MINUTES = "45"
MAX_TRADES_PER_SYMBOL_PER_DAY = "2"
OPTION_STOP_LOSS_PCT = "0.20"
OPTION_MAX_RISK_PER_TRADE_PCT = "0.12"
OPTION_MIN_CONTRACT_COST = "100"
OPTION_PREFERRED_MAX_CONTRACT_COST = "500"
OPTION_MAX_CONTRACT_COST = "650"
OPTION_AGGRESSIVE_MAX_CONTRACT_COST = "750"
OPTION_MIN_AFFORDABLE_DELTA = "0.25"
OPTION_SHOW_BEST_QUALITY_CONTRACT = "true"
OPTION_SHOW_AFFORDABLE_ALTERNATE = "true"

[telegram]
bot_token = "YOUR_BOT_TOKEN_FROM_BOTFATHER"
chat_id = "YOUR_TELEGRAM_CHAT_ID"

# TOML note: keys after [telegram] belong to the telegram table until another
# [section] starts. Keep root-level DB keys above [telegram], or use [database].
