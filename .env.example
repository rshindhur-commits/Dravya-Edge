APP_ENV=production
DATA_PATH=data
LOG_PATH=logs

# Required for live market data and live options chain.
POLYGON_API_KEY=

# Optional. Set false for a deterministic, no-AI daily scanner run.
ENABLE_AI_SUMMARY=false
AI_REQUEST_TIMEOUT_SECONDS=10
OPENAI_API_KEY=

# Production defaults should keep mock data off so stale/live-data failures are visible.
USE_MOCK_MARKET_DATA=false
USE_MOCK_OPTIONS=false

# Account and risk controls used by the position sizing report.
ACCOUNT_SIZE=25000
RISK_PERCENT=2

# Output/report controls.
SCANNER_OUTPUT_FILE=scanner_output.xlsx
SCANNER_DEBUG=false
POLYGON_RATE_LIMIT_PER_MINUTE=1200
POLYGON_CACHE_TTL=10
POLYGON_LAST_PRICE_TTL=10
USE_EXTENDED_HOURS=true